{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DX Cluster Desktop",
  "version": "1.4.5",
  "identifier": "hu.dacr.dxclusterdesktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "DX Cluster Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/cty.dat": "resources/cty.dat",
      "resources/dxclusters.dat": "resources/dxclusters.dat",
      "resources/rbn_skimmers.tsv": "resources/rbn_skimmers.tsv",
      "../user-manual/en/*.md": "resources/user-manual/en/",
      "../user-manual/hu/*.md": "resources/user-manual/hu/",
      "../user-manual/de/*.md": "resources/user-manual/de/"
    },
    "category": "Utility",
    "shortDescription": "Ham radio DX cluster client",
    "longDescription": "User-friendly multiplatform desktop client for ham radio DX clusters over Telnet.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {}
}
